{
  "name": "mdtheme",
  "version": "0.2.0",
  "description": "Compose Markdown documents with reusable brand frames and check generated READMEs for drift.",
  "keywords": [
    "cli",
    "documentation",
    "markdown",
    "readme",
    "theming"
  ],
  "homepage": "https://github.com/sebastian-software/mdtheme#readme",
  "bugs": {
    "url": "https://github.com/sebastian-software/mdtheme/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Sebastian Software GmbH",
    "url": "https://sebastian-software.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/mdtheme.git"
  },
  "bin": {
    "mdtheme": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c oxlint.config.ts && eslint . --max-warnings=0",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node --test test/*.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "standards:check": "standards check",
    "agent:check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm check:dist && pnpm test && pnpm readme:check && pnpm verify:package && pnpm standards:check",
    "prepack": "pnpm build",
    "check:dist": "git diff --exit-code -- dist",
    "readme:write": "node dist/cli.js --write",
    "readme:check": "node dist/cli.js --check"
  },
  "dependencies": {
    "jiti": "2.7.0",
    "smol-toml": "1.8.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@sebastian-software/standards": "0.10.0",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "eslint-config-setup": "0.5.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "sebastian-theme": "github:sebastian-software/sebastian-theme#7c95729a4ef606eb7844afce8c2ce8f2718a7569",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
