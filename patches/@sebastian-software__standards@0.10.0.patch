index 0000000000000000000000000000000000000000..0f083073eb6a703796f175fd1ae6a2d9c2b2c3dd
--- /dev/null
+++ b/dist/readme.js
@@ -0,0 +1,159 @@
+import { existsSync, lstatSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+export const MARKDOWN_THEMER_CONFIG_FILENAMES = [
+    "markdown-themer.config.ts",
+    "markdown-themer.config.mts",
+    "markdown-themer.config.js",
+    "markdown-themer.config.mjs",
+];
+const GENERATED_NOTICE = "<!-- This file is generated by markdown-themer. Edit README.md.src instead. -->";
+const LEGACY_BRANDING_MARKER = /<!--\s*sebastian-software-branding:(?:start|end)\s*-->/u;
+function isRecord(value) {
+    return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+function regularFile(path) {
+    try {
+        const info = lstatSync(path);
+        return info.isFile();
+    }
+    catch {
+        return false;
+    }
+}
+function readUtf8(path) {
+    try {
+        return readFileSync(path, "utf8");
+    }
+    catch {
+        return undefined;
+    }
+}
+function packageScripts(cwd) {
+    const raw = readUtf8(join(cwd, "package.json"));
+    if (raw === undefined)
+        return undefined;
+    try {
+        const parsed = JSON.parse(raw);
+        if (!isRecord(parsed))
+            return undefined;
+        if (!("scripts" in parsed))
+            return {};
+        const scripts = parsed.scripts;
+        return isRecord(scripts) ? scripts : undefined;
+    }
+    catch {
+        return undefined;
+    }
+}
+function validReadmeScript(value, operation) {
+    if (typeof value !== "string")
+        return false;
+    const command = value.trim();
+    return command === `markdown-themer ${operation}` || command === `node dist/cli.js ${operation}`;
+}
+function sourceIssues(cwd) {
+    const issues = [];
+    const source = join(cwd, "README.md.src");
+    if (!regularFile(source)) {
+        issues.push({
+            path: "README.md.src",
+            detail: "markdown-themer source must be a regular non-symlink file at the repository root",
+        });
+    }
+    const sourceContent = regularFile(source) ? readUtf8(source) : undefined;
+    if (sourceContent !== undefined && LEGACY_BRANDING_MARKER.test(sourceContent)) {
+        issues.push({
+            path: "README.md.src",
+            detail: "remove the legacy sebastian-software-branding marker from README.md.src before generating README.md",
+        });
+    }
+    return issues;
+}
+function outputIssues(cwd) {
+    const issues = [];
+    const output = join(cwd, "README.md");
+    const outputIsRegular = regularFile(output);
+    const outputContent = outputIsRegular ? readUtf8(output) : undefined;
+    if (!outputIsRegular) {
+        issues.push({
+            path: "README.md",
+            detail: "markdown-themer output must be a regular non-symlink file at the repository root",
+        });
+    }
+    else if (outputContent?.split(/\r?\n/u)[0] !== GENERATED_NOTICE) {
+        issues.push({
+            path: "README.md",
+            detail: "README.md is missing the markdown-themer generated-file notice; run markdown-themer --write",
+        });
+    }
+    if (outputContent !== undefined && LEGACY_BRANDING_MARKER.test(outputContent)) {
+        issues.push({
+            path: "README.md",
+            detail: "remove the legacy sebastian-software-branding marker; markdown-themer owns README branding",
+        });
+    }
+    return issues;
+}
+function configIssues(cwd) {
+    const configs = MARKDOWN_THEMER_CONFIG_FILENAMES.filter((name) => existsSync(join(cwd, name)));
+    if (configs.length === 0) {
+        return [
+            {
+                path: "markdown-themer.config.*",
+                detail: "exactly one supported markdown-themer config is required at the repository root",
+            },
+        ];
+    }
+    if (configs.length > 1) {
+        return [
+            {
+                path: "markdown-themer.config.*",
+                detail: `multiple supported configs found (${configs.join(", ")}); keep exactly one`,
+            },
+        ];
+    }
+    const config = configs[0];
+    if (config !== undefined && regularFile(join(cwd, config)))
+        return [];
+    return [
+        {
+            path: config ?? "markdown-themer.config.*",
+            detail: "the markdown-themer config must be a regular non-symlink file",
+        },
+    ];
+}
+function packageIssues(cwd) {
+    const scripts = packageScripts(cwd);
+    if (scripts === undefined) {
+        return [
+            {
+                path: "package.json",
+                detail: "package.json with scripts is required for markdown-themer wiring",
+            },
+        ];
+    }
+    const issues = [];
+    if (!validReadmeScript(scripts["readme:write"], "--write")) {
+        issues.push({
+            path: "package.json",
+            detail: "scripts.readme:write must invoke `markdown-themer --write` or `node dist/cli.js --write`",
+        });
+    }
+    if (!validReadmeScript(scripts["readme:check"], "--check")) {
+        issues.push({
+            path: "package.json",
+            detail: "scripts.readme:check must invoke `markdown-themer --check` or `node dist/cli.js --check`",
+        });
+    }
+    return issues;
+}
+/**
+ * Check the static prerequisites for a repository that delegates README
+ * ownership to markdown-themer. This deliberately does not load the config:
+ * configuration files are trusted executable code and standards must remain a
+ * read-only checker at this boundary.
+ */
+export function markdownThemerMigrationIssues(cwd) {
+    const packageIssuesResult = packageIssues(cwd);
+    return [...sourceIssues(cwd), ...outputIssues(cwd), ...configIssues(cwd), ...packageIssuesResult];
+}
